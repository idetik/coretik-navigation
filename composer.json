{
    "name": "idetik/coretik-navigation",
    "description": "Service navigation",
    "type": "library",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "David",
            "email": "david.daugreilh@idetik.fr"
        }
    ],
    "autoload": {
        "psr-4": {
            "Coretik\\Navigation\\": [
                "src"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coretik\\Navigation\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "idetik/coretik": "^1.4 || ^2.0",
        "globalis/wp-cubi-helpers": "^1.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpunit/phpunit": "^11.5",
        "brain/monkey": "^2.6",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    }
}
